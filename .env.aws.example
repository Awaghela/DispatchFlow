# Copy to .env.aws (never commit .env.aws) and fill in. Used only by `make aws-up`.
# Keys belong to an IAM user that has ONLY the policy in infra/aws/worker-policy.json.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Printed by infra/aws/create_sqs.sh, e.g. https://sqs.us-east-1.amazonaws.com/123456789012/dispatchflow-orders
SQS_QUEUE_URL=
SQS_DLQ_URL=
