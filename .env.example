REDIS_URL=redis://localhost:6379/0
AWS_REGION=us-east-1
# Local emulator only (leave unset for real AWS):
# AWS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_NAME=dispatchflow-orders
SQS_DLQ_NAME=dispatchflow-orders-dlq
